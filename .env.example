# Folder to tidy. Start with a COPY of some files, not your real Downloads.
WATCH_DIR=./watched
DB_PATH=./slothsort.db
DRY_RUN=true             # true = propose moves and you approve. false = auto-move confident ones.
AUTO_WATCH=false         # true = scan every POLL_SECONDS
CONFIDENCE_THRESHOLD=0.6

# openai | llamacpp | gemini | heuristic (rules only, no AI)
LLM_BACKEND=openai

# openai = LM Studio / llama.cpp server / vLLM running a Gemma model on your machine.
# LM Studio default is below. Leave LLM_MODEL empty to use whichever model is loaded.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=

# llamacpp = Gemma GGUF file loaded in-process (pip install llama-cpp-python)
GGUF_PATH=

# gemini = Gemma through the Google API (network call, so DEMO_MODE=true is required)
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
DEMO_MODE=false
